# Copie para ".env" (nesta mesma pasta) e preencha. NUNCA suba o .env para o GitHub.

# Endereço do site: ":80" para testar pelo IP; depois troque pelo domínio (ex.: mobhillmotos.com.br)
SITE_ADDRESS=:80

# MySQL HeatWave (IP privado do DB System)
DB_HOST=10.0.1.xxx
DB_NAME=motos
# Primeira subida (criar tabelas): motos_ddl + DDL_AUTO=update
# Depois: motos_app + DDL_AUTO=validate
DB_USER=motos_ddl
DB_PASSWORD=senha-do-motos_ddl
DDL_AUTO=update

# Segredo que assina os logins do painel. Gere com:  openssl rand -base64 48
JWT_SECRET=

# Usuário admin criado automaticamente na primeira subida (troque a senha!)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Documentação da API (Swagger). Deixe false em produção.
SWAGGER_ENABLED=false
